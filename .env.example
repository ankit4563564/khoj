# Copy to .env.local and fill these locally; never paste secret keys into chat.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Exact canonical origin, also add /auth/callback to Supabase redirect allowlist.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The college domain is deliberately fixed at rvu.edu.in in code and SQL.
# Random 32+ character server-only secret for hashing rate-limit identifiers.
RATE_LIMIT_SECRET=
