# Node.js 22.13+ is required for SQLite. Use Node 24 LTS in production.
APP_URL=http://127.0.0.1:3100
RVU_EMAIL_DOMAINS=rvu.edu.in
# Persistent local disk on a single Node server; not an ephemeral/serverless path.
# RVU_DB_PATH=/var/lib/khoj/rvu.sqlite

# Required for password signup and reset email delivery in production.
RESEND_API_KEY=
EMAIL_FROM=

# Optional verified Google university sign-in.
# Register APP_URL/api/rvu/google as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional photo-to-details analysis; metadata matching works without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Authoritative Supabase / Postgres production connection (required for Vercel/Supabase deployments)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
